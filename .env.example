# ---- EYYY self-host configuration -------------------------------------------
# Each deployment serves ONE Slack workspace and/or ONE Google Chat org (yours).
# You run this; no data is sent to anyone else.

# Server
PORT=3000
# Use "development" only for local testing (skips signature/token verification).
NODE_ENV=production

# Your recognition VALUES and GIFs. Two ways to provide them (JSON wins over PATH):
#   EYY_CONFIG_JSON  — the whole config as one line (easiest on Railway/Render)
#   EYY_CONFIG_PATH  — path to an eyy.config.json file (easiest locally / in Docker)
# If neither is set, a neutral built-in sample set is used.
# EYY_CONFIG_JSON=
EYY_CONFIG_PATH=./eyy.config.json

# ---- Database (PostgreSQL) — the kudos store --------------------------------
DATABASE_URL=postgresql://localhost:5432/eyy
# SSL mode: disable | require | verify. Leave blank to auto-detect managed
# hosts (e.g. Railway). Use "verify" with a CA-backed Postgres for strict TLS.
DATABASE_SSL=

# ---- GIFs (optional) --------------------------------------------------------
# Your own Giphy API key: https://developers.giphy.com/  (leave blank for no GIFs,
# or use per-value fixed "url" links in eyy.config.json instead of searches).
GIPHY_API_KEY=

# Public HTTPS URL of THIS deployment (used to build the Google Chat dialog URL).
PUBLIC_BASE_URL=https://your-domain

# ---- Slack (optional: set BOTH to enable the Slack endpoints) ---------------
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=

# ---- Google Chat (optional: set to enable Google Chat) ---------------------
# The endpoint URL you registered for the Chat app; used as the token audience.
GOOGLE_CHAT_AUDIENCE=https://your-domain/google-chat
